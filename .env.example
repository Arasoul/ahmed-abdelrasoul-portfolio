# Web3Forms access key (https://web3forms.com) — used by the Contact form.
# Get your key from the Web3Forms dashboard email, then set it here locally
# and in your hosting provider's environment variables (e.g. Vercel).
VITE_WEB3FORMS_ACCESS_KEY=

# Public flag that enables the LLM-enhanced Portfolio Intelligence assistant.
# This is NOT a secret — it only switches the UI between "LLM" and "local
# retrieval" modes. The assistant calls the /api/portfolio-ai serverless
# function, which holds the real API key server-side (see LLM_* below).
VITE_LLM_ENABLED=false

# Server-side variables for the /api/portfolio-ai function.
# Only the function reads these (no VITE_ prefix, never shipped to the client).
# Required only when you want LLM answers; set them on your host too.
LLM_ENDPOINT=
LLM_API_KEY=
# LLM_MODEL=
# ALLOWED_ORIGINS=